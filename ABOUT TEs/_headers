/*
  Link: </.well-known/ai-catalog.json>; rel="ai-catalog"; type="application/json"
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'none'; style-src 'self'; img-src 'self' data: https://emo-changeling.xyz https://*.emo-changeling.xyz https://toxic-echo.studio https://*.toxic-echo.studio; font-src 'self' data:; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self';

/img/*
  Cache-Control: public, max-age=31536000, immutable, no-transform

/css/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800, no-transform

/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: no-cache
  Content-Type: text/plain; charset=utf-8

/.well-known/robots.txt
  Cache-Control: no-cache
  Content-Type: text/plain; charset=utf-8

/humans.txt
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/plain; charset=utf-8

/.well-known/llms.txt
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/plain; charset=utf-8

/llms.toml
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/toml; charset=utf-8

/.well-known/llms.toml
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/toml; charset=utf-8

/llms.yaml
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/yaml; charset=utf-8

/.well-known/llms.yaml
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/yaml; charset=utf-8

/ai.json
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/json; charset=utf-8

/.well-known/ai.json
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/json; charset=utf-8

/ai.txt
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/plain; charset=utf-8

/.well-known/ai.txt
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/plain; charset=utf-8

/ai.pub
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/plain; charset=utf-8

/.well-known/ai.pub
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/plain; charset=utf-8

/.well-known/security.txt
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/plain; charset=utf-8

/.well-known/openpgpkey/*
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache
  Content-Type: application/octet-stream

/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json; charset=utf-8

/favicon.svg
  Content-Type: image/svg+xml; charset=utf-8

/img/EmoChangeling.svg
  Content-Type: image/svg+xml; charset=utf-8

/pgp-key.txt
  Content-Type: text/plain; charset=utf-8

/.well-known/pgp-key.txt
  Content-Type: text/plain; charset=utf-8

/.well-known/ai-catalog.json
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/json; charset=utf-8
